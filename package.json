{
	"name": "comedy-connector-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"dev": "vite dev",
		"predev:prod": "rm -rf build",
		"dev:prod": "PUBLIC_DEPLOY_CONTEXT=deploy-preview vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"netlify": "netlify",
		"db:setup": "drizzle-kit push && drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed:staging": "tsx --env-file .env scripts/seed-staging.ts"
	},
	"devDependencies": {
		"@netlify/functions": "^2.8.2",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.0",
		"drizzle-kit": "^0.31.10",
		"netlify-cli": "^26.0.2",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.3",
		"tailwindcss": "^4.2.0",
		"tsx": "^4.22.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.5"
	},
	"dependencies": {
		"@skeletonlabs/skeleton": "^4.12.0",
		"@skeletonlabs/skeleton-svelte": "^4.12.0",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.106.1",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^0.483.0",
		"postgres": "^3.4.9",
		"resend": "^4.8.0",
		"zod": "^3.25.76"
	}
}
